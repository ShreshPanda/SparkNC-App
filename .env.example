# SparkNC Expo frontend environment variables.
# Copy this file to .env and fill in the real values.
# No secrets should be placed here; these values are embedded into the bundle at build time.

# The full URL of the deployed Cloudflare Worker backend.
# When running locally with `wrangler dev`, set this to http://localhost:8787
EXPO_PUBLIC_CLOUDFLARE_WORKER_URL=https://sparknc-api.<your_subdomain>.workers.dev

# Optional: human readable app name surfaced in the UI if needed.
EXPO_PUBLIC_APP_NAME=SparkNC

# Note: backend secrets (SESSION_SECRET, BETTER_AUTH_SECRET, etc.) live in
# .dev.vars (local) or the Cloudflare dashboard (production). See .dev.vars.example.
