# SparkNC local development secrets for `wrangler dev`.
# Copy this file to .dev.vars and fill in real values.
# DO NOT commit .dev.vars to version control.

# Session cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_secret_replace_with_random_32_byte_hex



# Set to 'development' when running locally so cookies are not forced secure.
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
