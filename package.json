{
  "name": "sparknc",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p workers/tsconfig.json",
    "test:worker": "vitest run --config workers/vitest.config.ts",
    "types:worker": "wrangler types",
    "verify": "npm run typecheck && npm run typecheck:worker && npm run test:worker && wrangler types --check",
    "check:deployment": "node scripts/check-deployment-readiness.mjs",
    "migrate:local": "node scripts/apply-d1-migrations.mjs",
    "migrate:remote": "node scripts/apply-d1-migrations.mjs",
    "deploy:dry-run": "node scripts/deploy-worker.mjs production dry-run",
    "deploy:worker": "node scripts/deploy-worker.mjs production deploy",
    "deploy:staging:dry-run": "node scripts/deploy-worker.mjs staging dry-run",
    "deploy:staging": "node scripts/deploy-worker.mjs staging deploy",
    "health:check": "node scripts/check-worker-health.mjs",
    "worker:startup": "wrangler check startup",
    "rollback:worker": "node scripts/rollback-worker.mjs production",
    "rollback:staging": "node scripts/rollback-worker.mjs staging",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.101.2",
    "better-auth": "^1.6.23",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^57.0.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0",
    "zod": "^4.4.3"
  },
  "private": true
}
